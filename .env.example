# .env.example — copy to .env for local development
# NEVER commit .env to version control.

# API keys accepted by this service (comma-separated)
VALID_API_KEYS=test-key-001,test-key-002

# Domain lock: each key maps to one allowed Origin domain
# Format: key:domain,key:domain,...
# Use * as domain to allow any origin for a specific key (dev only)
API_KEY_DOMAINS=test-key-001:teststore.com,test-key-002:demo.in
